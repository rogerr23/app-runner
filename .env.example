# Public values used by the browser and server. The publishable key is safe to
# expose only when Row Level Security remains enabled on every public table.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this variable with NEXT_PUBLIC_ or commit its value.
SUPABASE_SECRET_KEY=

# Used to build absolute redirects in authentication flows.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

